{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentwine.invalid/contracts/code-evidence/1.0",
  "title": "Code delivery evidence design draft; authority must be verified server-side",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "org_id", "evidence_kind", "producer_identity", "spec_revision_id", "commit_set", "environment_digest", "test_plan_hash", "result", "artifact_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "fixture_only": {"type": "boolean"},
    "evidence_id": {"type": "string", "minLength": 1}, "org_id": {"type": "string", "minLength": 1},
    "evidence_kind": {"enum": ["trusted_tool_result", "human_attestation", "agent_claim"]},
    "producer_identity": {"type": "string", "minLength": 1},
    "spec_revision_id": {"type": "string", "minLength": 1},
    "commit_set": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["repository_id", "commit_sha"],
      "properties": {"repository_id": {"type": "string", "minLength": 1}, "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
    }},
    "environment_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "test_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {"enum": ["passed", "failed", "error", "skipped", "unknown"]},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "stale_reason": {"type": ["string", "null"]}
  }
}
