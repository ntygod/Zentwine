{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentwine.invalid/contracts/runtime-start/1.0",
  "title": "Zentwine StartRun design draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "org_id", "run_id", "task_id", "context_snapshot_id", "model_binding", "workspace_id", "lease_epoch", "policy_snapshot_id", "budget_reservation_id", "input_artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixture_only": {"type": "boolean"},
    "org_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "policy_snapshot_id": {"type": "string", "minLength": 1},
    "budget_reservation_id": {"type": "string", "minLength": 1},
    "model_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "requested_model_id", "runtime_id", "adapter_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "requested_model_id": {"type": "string", "minLength": 1},
        "runtime_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input_artifacts": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "revision", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
