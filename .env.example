# Development only. No model credentials are needed or accepted by the bootstrap service.
NODE_ENV=development
ZENTWINE_HOST=127.0.0.1
ZENTWINE_API_PORT=4100
ZENTWINE_LOG_LEVEL=info
ZENTWINE_BODY_LIMIT_BYTES=16384
ZENTWINE_REQUEST_TIMEOUT_MS=30000
ZENTWINE_SHUTDOWN_TIMEOUT_MS=5000
# Optional future DB consumer only; bootstrap neither requires nor connects it.
# ZENTWINE_DATABASE_URL=postgresql://localhost/zentwine_development
