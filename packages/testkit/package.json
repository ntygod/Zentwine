{
  "name": "@zentwine/testkit",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./temporary-directory": {
      "types": "./dist/temporary-directory.d.ts",
      "default": "./dist/temporary-directory.js"
    }
  },
  "dependencies": {
    "@zentwine/domain": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
