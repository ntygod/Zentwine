{
  "name": "zentwine",
  "version": "0.1.0-dev.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm -r --sort run typecheck",
    "lint": "oxlint apps services/api packages scripts tests && node scripts/check-boundaries.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "docs:check": "python scripts/validate_plans.py",
    "doctor": "node scripts/doctor.mjs",
    "test:foundation": "node --test tests/foundations.test.mjs tests/logging-boundaries.test.mjs tests/observability-api.test.mjs",
    "test:fixtures": "node --test tests/fake-runtime.test.mjs tests/fake-runtime-network.test.mjs tests/testkit-environment.test.mjs",
    "test:integration": "node scripts/run-database-tests.mjs",
    "contract-check": "node scripts/export-contracts.mjs && python3 scripts/quality/gate.py contracts",
    "migration-check": "python3 scripts/quality/gate.py migrations",
    "test:migrations": "node scripts/run-migration-tests.mjs",
    "test:integrity": "node scripts/check-test-integrity.mjs && python3 scripts/quality/gate.py tests",
    "secret-check": "python3 scripts/quality/gate.py secrets",
    "test:quality": "node --test tests/quality/*.test.mjs && python3 -m unittest discover -s tests/quality -p \"test_*.py\" -v",
    "test:live": "python3 scripts/quality/gate.py live-status",
    "quality:check": "pnpm test:integrity && pnpm secret-check && pnpm contract-check && pnpm migration-check && python3 scripts/quality/gate.py workflows && python3 scripts/quality/gate.py dependencies && pnpm test:quality",
    "env:up": "node scripts/environment.mjs up",
    "env:status": "node scripts/environment.mjs status",
    "env:down": "node scripts/environment.mjs down",
    "tools:prepare": "node scripts/prepare-tools.mjs",
    "drill": "node scripts/drill.mjs",
    "test:development": "node --test tests/development.test.mjs",
    "test:environment": "node --test tests/development/stack.test.mjs tests/development/recovery.test.mjs",
    "test:dev-lifecycle": "node --test tests/development/launch.test.mjs",
    "test:identity": "node scripts/run-identity-tests.mjs",
    "test:identity-security": "node --test tests/identity-security.test.mjs",
    "identity:admin": "node scripts/identity-admin.mjs",
    "identity:serve": "node services/api/dist/main.js",
    "test:policy": "node --test tests/policy.test.mjs",
    "test:policy-integration": "node scripts/run-policy-tests.mjs",
    "policy:admin": "node scripts/policy-admin.mjs",
    "test:agents": "node --test tests/agents.test.mjs",
    "test:agents-integration": "node scripts/run-agent-tests.mjs",
    "agents:admin": "node scripts/agent-admin.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "@types/node": "24.13.3",
    "@playwright/test": "1.63.0",
    "oxlint": "1.81.0",
    "prettier": "3.6.2",
    "pg": "8.16.3"
  }
}
